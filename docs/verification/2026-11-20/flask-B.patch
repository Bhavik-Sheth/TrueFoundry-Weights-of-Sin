+class TestConfig:
+    @pytest.fixture
+    def app(self):
+        app = Flask(__name__)
+        app.config.update(
+            FOO="bar",
+            SECRET_KEY="secret",
+            DB_PASSWORD="hunter2",
+            API_TOKEN="abc123",
+            PRIVATE_KEY="priv",
+            NORMAL_VALUE=42,
+        )
+        return app
+
+    @pytest.fixture
+    def invoke(self, app, runner):
+        cli = FlaskGroup(create_app=lambda: app)
+        return partial(runner.invoke, cli)
+
+    def test_simple(self, invoke):
+        result = invoke(["config"])
+        assert result.exit_code == 0
+        data = json.loads(result.output)
+        assert data["FOO"] == "bar"
+        assert data["NORMAL_VALUE"] == 42
+        assert data["SECRET_KEY"] == "***"
+        assert data["DB_PASSWORD"] == "***"
+        assert data["API_TOKEN"] == "***"
+        assert data["PRIVATE_KEY"] == "***"
+
+    def test_is_in_help(self, invoke):
+        result = invoke(["--help"])
+        assert result.exit_code == 0
+        assert "config" in result.output
