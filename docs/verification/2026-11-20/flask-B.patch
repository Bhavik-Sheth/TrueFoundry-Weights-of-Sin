+def _is_sensitive_config_key(key: str) -> bool:
+    """Whether a config key's value should be masked in output."""
+    upper_key = key.upper()
+    sensitive_words = ("SECRET", "PASSWORD", "TOKEN", "KEY")
+    return any(word in upper_key for word in sensitive_words)
+
+
+@click.command("config", short_help="Show the application configuration.")
+@with_appcontext
+def config_command() -> None:
+    """Show the configuration for the current application.
+
+    Values for keys containing ``SECRET``, ``PASSWORD``, ``TOKEN``, or
+    ``KEY`` are masked as ``***``.
+    """
+    data: dict[str, t.Any] = {}
+
+    for key, value in current_app.config.items():
+        if _is_sensitive_config_key(key):
+            data[key] = "***"
+        else:
+            data[key] = value
+
+    click.echo(json.dumps(data, indent=2, sort_keys=True, default=str))
+
