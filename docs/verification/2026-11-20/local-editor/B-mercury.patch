+_SENSITIVE_CONFIG_KEYS = ("SECRET", "PASSWORD", "TOKEN", "KEY")
+
+
+@click.command("config", short_help="Show the config for the app.")
+@with_appcontext
+def config_command() -> None:
+    """Show the loaded application's configuration as JSON, masking values of
+    keys that contain "SECRET", "PASSWORD", "TOKEN", or "KEY".
+
+    Sensitive values are replaced with a masked placeholder instead of their
+    true value.
+    """
+    config = current_app.config.copy()
+
+    for key in config:
+        if any(word in key.upper() for word in _SENSITIVE_CONFIG_KEYS):
+            config[key] = "***"
+
+    def json_default(value: t.Any) -> t.Any:
+        return str(value)
+
+    click.echo(json.dumps(config, indent=2, default=json_default))
+
+
