diff --git a/tests/test_main.py b/tests/test_main.py
index b1a77d4..4bbf5b1 100644
--- a/tests/test_main.py
+++ b/tests/test_main.py
@@ -185,3 +185,21 @@ def test_errors():
     assert splitlines(result.output) == [
         "UnsupportedProtocol: Request URL has an unsupported protocol 'invalid://'.",
     ]
+
+
+def test_timeout_rejects_invalid_values(server):
+    runner = CliRunner()
+    url = str(server.url)
+    for value in ["0", "-5", "inf", "-inf", "nan"]:
+        result = runner.invoke(httpx.main, [url, "--timeout", value])
+        assert result.exit_code == 2
+        assert (
+            "must be a finite, positive number of seconds" in result.output
+        )
+
+
+def test_timeout_accepts_fractional_seconds(server):
+    runner = CliRunner()
+    url = str(server.url)
+    result = runner.invoke(httpx.main, [url, "--timeout", "0.5"])
+    assert result.exit_code == 0
