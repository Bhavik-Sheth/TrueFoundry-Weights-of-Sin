{
  "$comment": "Minimal VS Code manifest skeleton (C1). main is the esbuild bundle of src/extension.ts; contributes holds commands, the ctrl+alt+e / cmd+alt+e keybinding (editorHasSelection), the secondary-sidebar webview view contexo.panel and the PRD_Lite 9.6 settings. Scripts, dependencies and devDependencies (see UPSTREAMS.md) are added when packages are installed. Include a 'check' script that greps for provider SDKs/URLs.",
  "name": "contexo",
  "displayName": "Contexo",
  "description": "Context-aware, staged per-hunk code edits driven by a TrueForge agent.",
  "version": "0.0.1",
  "publisher": "contexo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bhavik-Sheth/TrueFoundry-Weights-of-Sin.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      { "command": "contexo.recoverApply", "title": "Contexo: Recover Interrupted Apply" },
      { "command": "contexo.checkCandidate", "title": "Contexo: Test Accepted Hunks Before Apply" },
      { "command": "contexo.importSecurityReport", "title": "Contexo: Attach SARIF Security Report" },
      { "command": "contexo.openRunRecord", "title": "Contexo: Open Run Record" },
      {
        "command": "contexo.inlineEdit",
        "title": "Contexo: Inline Edit"
      },
      {
        "command": "contexo.stop",
        "title": "Contexo: Stop"
      },
      {
        "command": "contexo.undoHunk",
        "title": "Contexo: Undo Hunk"
      },
      {
        "command": "contexo.redoHunk",
        "title": "Contexo: Redo Hunk"
      },
      {
        "command": "contexo.copyMcpConnection",
        "title": "Contexo: Copy MCP Connection"
      },
      {
        "command": "contexo.openSetup",
        "title": "Contexo: Open Setup"
      },
      {
        "command": "contexo.stopTrueForge",
        "title": "Contexo: Stop TrueForge"
      },
      {
        "command": "contexo.reindex",
        "title": "Contexo: Reindex Workspace"
      },
      {
        "command": "contexo.hunk.decide",
        "title": "Contexo: Decide Hunk"
      },
      {
        "command": "contexo.proposal.apply",
        "title": "Contexo: Apply Accepted Hunks"
      },
      {
        "command": "contexo.proposal.rejectAll",
        "title": "Contexo: Reject All Hunks"
      },
      {
        "command": "contexo.proposal.acceptAll",
        "title": "Contexo: Accept All Hunks"
      },
      {
        "command": "contexo.dev.pingTrueForge",
        "title": "Contexo Dev: Ping TrueForge"
      },
      {
        "command": "contexo.dev.sendTestTurn",
        "title": "Contexo Dev: Send Test Turn"
      },
      {
        "command": "contexo.dev.showSamplePacket",
        "title": "Contexo Dev: Show Sample Context Packet"
      },
      {
        "command": "contexo.dev.openSampleProposal",
        "title": "Contexo Dev: Open Sample Proposal"
      },
      {
        "command": "contexo.dev.openSampleProposalMissingSymbol",
        "title": "Contexo (dev): Open Sample Proposal (missing symbol)"
      },
      {
        "command": "contexo.dev.applySampleChange",
        "title": "Contexo Dev: Apply Sample Change"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "contexo.inlineEdit",
          "when": "editorHasSelection",
          "group": "1_modification@1"
        }
      ],
      "commandPalette": [
        {
          "command": "contexo.dev.pingTrueForge",
          "when": "config.contexo.devMode"
        },
        {
          "command": "contexo.dev.sendTestTurn",
          "when": "config.contexo.devMode"
        },
        {
          "command": "contexo.dev.showSamplePacket",
          "when": "config.contexo.devMode"
        },
        {
          "command": "contexo.dev.openSampleProposal",
          "when": "config.contexo.devMode"
        },
        {
          "command": "contexo.dev.openSampleProposalMissingSymbol",
          "when": "config.contexo.devMode"
        },
        {
          "command": "contexo.dev.applySampleChange",
          "when": "config.contexo.devMode"
        },
        {
          "command": "contexo.hunk.decide",
          "when": "false"
        },
        {
          "command": "contexo.proposal.apply",
          "when": "false"
        },
        {
          "command": "contexo.proposal.rejectAll",
          "when": "false"
        },
        {
          "command": "contexo.proposal.acceptAll",
          "when": "false"
        },
        {
          "command": "contexo.undoHunk",
          "when": "false"
        },
        {
          "command": "contexo.redoHunk",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "contexo.inlineEdit",
        "key": "ctrl+k e",
        "mac": "cmd+k e",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "contexo",
          "title": "Contexo",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "contexo": [
        {
          "type": "webview",
          "id": "contexo.panel",
          "name": "Contexo"
        }
      ]
    },
    "configuration": {
      "title": "Contexo",
      "properties": {
        "contexo.trueforgeUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "TrueForge local server URL."
        },
        "contexo.primaryAgent": {
          "type": "string",
          "default": "contexo",
          "description": "Primary TrueForge agent name."
        },
        "contexo.fallbackAgent": {
          "type": "string",
          "default": "contexo-fallback",
          "description": "Fallback TrueForge agent name."
        },
        "contexo.excerptBudget": {
          "type": "number",
          "default": 8000,
          "description": "Token budget for assembled excerpts."
        },
        "contexo.firstEventTimeoutMs": {
          "type": "number",
          "default": 20000,
          "description": "Time to wait for the first stream event before treating the model as failed."
        },
        "contexo.commandAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "python",
            "pytest",
            "flask"
          ],
          "description": "Allowed argv[0] values for run_command."
        },
        "contexo.mcpPort": {
          "type": "number",
          "default": 8791,
          "description": "Fixed port for the local Contexo MCP server."
        },
        "contexo.stopTrueForgeOnExit": {
          "type": "string",
          "enum": ["startedByContexo", "always", "never"],
          "enumDescriptions": [
            "Stop TrueForge when VS Code closes only if Contexo started it.",
            "Always stop the local TrueForge when VS Code closes, even one you started yourself.",
            "Never stop TrueForge when VS Code closes."
          ],
          "default": "startedByContexo",
          "description": "What happens to the local TrueForge when Contexo stops (VS Code closes or reloads)."
        },
        "contexo.autoStartTrueForge": {
          "type": "boolean",
          "default": true,
          "description": "Start a local TrueForge (npx @truefoundry/trueforge) automatically when it is not already running. Requires Node 22.14+."
        },
        "contexo.primaryModel": {
          "type": "string",
          "default": "",
          "description": "Primary model (provider/model) chosen in the Contexo setup. Models and keys are configured in TrueForge; this stores only the model name."
        },
        "contexo.fallbackModel": {
          "type": "string",
          "default": "",
          "description": "Fallback model (provider/model) chosen in the Contexo setup."
        },
        "contexo.devMode": {
          "type": "boolean",
          "default": false,
          "description": "Show Contexo dev/fixture commands in the Command Palette."
        }
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "@truefoundry/trueforge-ui": "0.185.1",
    "@xyflow/react": "13.0.2",
    "diff": "9.0.0",
    "js-tiktoken": "1.0.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tree-kill": "1.2.2",
    "web-tree-sitter": "0.27.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.90.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "tree-sitter-python": "0.25.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "scripts": {
    "build": "node esbuild.mjs && vite build",
    "watch": "node esbuild.mjs --watch",
    "watch:web": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "check": "node ../scripts/check-no-provider.mjs dist",
    "package": "npm run build && npm run check && vsce package --no-dependencies -o dist/contexo.vsix",
    "install:local": "npm run package && code --install-extension dist/contexo.vsix --force"
  }
}
